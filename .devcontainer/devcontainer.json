{
  "name": "service-discovery-brownfield",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python3 scripts/validate_brownfield_assets.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-github-actions",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "files.trimTrailingWhitespace": true,
        "editor.rulers": [100],
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "remoteEnv": {
    "BROWNFIELD_REPO_ROOT": "${containerWorkspaceFolder}"
  }
}
