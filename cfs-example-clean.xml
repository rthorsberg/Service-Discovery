<config xmlns="http://tail-f.com/ns/config/1.0">
  <netinfra xmlns="http://example.com/respnet/netinfra">
    <router>
      <name>CR-1</name>
      <role>
        <name>core</name>
      </role>
    </router>
    <router>
      <name>CR-2</name>
      <role>
        <name>core</name>
      </role>
    </router>
    <router>
      <name>CR-3</name>
      <role>
        <name>core</name>
      </role>
    </router>
    <router>
      <name>ER-1</name>
      <role>
        <name>edge</name>
      </role>
    </router>
    <router>
      <name>ER-2</name>
      <role>
        <name>edge</name>
      </role>
    </router>
    <router>
      <name>ER-3</name>
      <role>
        <name>edge</name>
      </role>
    </router>
    <backbone-link>
      <left-router>CR-1</left-router>
      <left-interface>eth1</left-interface>
      <right-router>CR-2</right-router>
      <right-interface>eth1</right-interface>
    </backbone-link>
    <backbone-link>
      <left-router>CR-1</left-router>
      <left-interface>eth2</left-interface>
      <right-router>CR-3</right-router>
      <right-interface>eth1</right-interface>
    </backbone-link>
    <backbone-link>
      <left-router>CR-1</left-router>
      <left-interface>eth3</left-interface>
      <right-router>ER-1</right-router>
      <right-interface>eth1</right-interface>
    </backbone-link>
    <backbone-link>
      <left-router>CR-1</left-router>
      <left-interface>eth4</left-interface>
      <right-router>ER-3</right-router>
      <right-interface>eth1</right-interface>
    </backbone-link>
    <backbone-link>
      <left-router>CR-2</left-router>
      <left-interface>eth2</left-interface>
      <right-router>CR-3</right-router>
      <right-interface>eth2</right-interface>
    </backbone-link>
    <backbone-link>
      <left-router>CR-2</left-router>
      <left-interface>eth3</left-interface>
      <right-router>ER-1</right-router>
      <right-interface>eth2</right-interface>
    </backbone-link>
    <backbone-link>
      <left-router>CR-2</left-router>
      <left-interface>eth4</left-interface>
      <right-router>ER-2</right-router>
      <right-interface>eth1</right-interface>
    </backbone-link>
    <backbone-link>
      <left-router>CR-3</left-router>
      <left-interface>eth3</left-interface>
      <right-router>ER-2</right-router>
      <right-interface>eth2</right-interface>
    </backbone-link>
    <backbone-link>
      <left-router>CR-3</left-router>
      <left-interface>eth4</left-interface>
      <right-router>ER-3</right-router>
      <right-interface>eth2</right-interface>
    </backbone-link>
  </netinfra>
</config>
